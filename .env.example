DATABASE_URL=postgresql://plainly:plainly@localhost:5433/plainly
AZURE_AI_ENDPOINT=
AZURE_AI_DEPLOYMENT=claude-sonnet-5
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_CREDENTIAL_EXPIRES_AT=
# Set true to try canned sample responses without calling an AI provider.
DEMO_MODE=false
PORT=3001
# When set, use the staging backend for chat instead of calling Foundry directly.
# npm run setup:backend creates the server-only session file.
BUILDPROMPT_URL=
# Optional override; BOI staging automatically selects the five investment demo collections.
# BUILDPROMPT_COLLECTION_IDS=
# Server-only key with Agents and Text to Speech permissions. Never use VITE_ for this key.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# Optional read-aloud voice override; defaults to Gareth, matching Ireland B Demo 2.
ELEVENLABS_VOICE_ID=GQrtVlpzdyQgC8wasmeY
