{
  "name": "plainly-chat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "setup:foundry": "node scripts/setup-foundry.mjs",
    "setup:backend": "node scripts/setup-backend.mjs",
    "dev": "concurrently -k -n api,web 'npm:dev:server' 'npm:dev:web'",
    "dev:web": "vite --host 127.0.0.1",
    "dev:server": "tsx watch server/index.ts",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "db:up": "docker compose up -d db",
    "db:migrate": "tsx server/migrate.ts",
    "check-and-fix": "biome check --write",
    "dead-code": "knip",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck:server": "tsc --noEmit -p tsconfig.server.json",
    "test:chat": "tsx --test server/chat.test.ts",
    "test:model": "tsx --test server/model.test.ts",
    "test:backend": "tsx --test server/backend.test.ts",
    "test:api": "tsx --test server/app.test.ts",
    "test:documents": "tsx --test server/documents.test.ts",
    "test:citations": "tsx --tsconfig tsconfig.web.json --test src/MessageContent.test.tsx",
    "test:charts": "tsx --tsconfig tsconfig.web.json --test src/ChartOutput.test.tsx"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.52",
    "@ai-sdk/react": "^4.0.100",
    "@azure/identity": "^4.13.2",
    "ai": "^7.0.97",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.12.2",
    "pdf-parse": "^2.4.5",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "@workos-inc/node": "^10.13.0",
    "concurrently": "^9.2.1",
    "knip": "^6.35.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^8.3.0"
  }
}
